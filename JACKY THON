class TestTemplateAdvisor(unittest.TestCase):
    def setUp(self):
        self.advisor = TemplateRemediationAdvisor()
        self.dependency = Dependency("lodash", "4.17.15", is_direct=True)
        self.vulnerability = vuln()

    def test_reachable_wording(self):
        text = self.advisor.explain(self.dependency, self.vulnerability,
                                    Reachability.REACHABLE, VersionStatus.VULNERABLE)
        self.assertIn("reachable in your source", text)
        self.assertIn("Upgrade lodash from 4.17.15 to 2.0.0", text)

    def test_unknown_reachability_wording_is_distinct(self):
        text = self.advisor.explain(self.dependency, self.vulnerability,
                                    Reachability.UNKNOWN, VersionStatus.VULNERABLE)
        self.assertIn("could not be determined", text)

    def test_unknown_version_tells_user_to_check_lockfile(self):
        dependency = Dependency("lodash", "*", is_direct=True)
        text = self.advisor.explain(dependency, self.vulnerability,
                                    Reachability.REACHABLE, VersionStatus.UNKNOWN)
        self.assertIn("lockfile", text)
        self.assertNotIn("Upgrade lodash from *", text)


