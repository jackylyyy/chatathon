#!/usr/bin/env python3
"""
snyk_ai_extension.py — AI-powered contextual vulnerability triage.

Pipeline:
    manifest file -> dependencies -> vulnerability lookup -> reachability
    analysis -> risk scoring -> AI-generated remediation guidance

This is the single-file build: the scanner and its full test suite live in one
module so it can be pasted into a Live Share session or dropped into a repo as
one artifact. Run --selftest to execute the tests.

Usage:
    python snyk_ai_extension.py --manifest package.json --source ./src
    python snyk_ai_extension.py --manifest requirements.txt --source . --no-ai
    python snyk_ai_extension.py --selftest
    python snyk_ai_extension.py --manifest package.json --source . --fail-on medium

Exit codes:
    0 — no findings at all
    1 — at least one finding at or above the --fail-on threshold (default: high)
    2 — could not complete analysis (bad input, unreadable files)
    3 — findings present, but all below the --fail-on threshold
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
from abc import ABC, abstractmethod
from collections.abc import Iterable
from dataclasses import dataclass
from enum import Enum
from pathlib import Path
from typing import Optional

# Windows editors and PowerShell routinely emit a UTF-8 BOM. 'utf-8-sig' strips
# one if present and is identical to 'utf-8' otherwise, so every file this tool
# reads goes through it: a BOM used to hard-fail manifest parsing, and it also
# defeats a first-line import match (re's \s does not cover U+FEFF).
_ENCODING = "utf-8-sig"


# ==========================================================================
# Domain model
# ==========================================================================

class Severity(Enum):
    LOW = 1
    MEDIUM = 2
    HIGH = 3
    CRITICAL = 4

    @classmethod
    def from_str(cls, value: str) -> "Severity":
        try:
            return cls[value.upper()]
        except KeyError:
            raise ValueError(f"Unknown severity level: '{value}'")


class Reachability(Enum):
    """
    Three states, not two. "We could not tell" must never be scored as
    "not used" — that is the one direction in which a triage tool can
    silently hide a live vulnerability.
    """
    REACHABLE = "reachable"
    NOT_FOUND = "not-found"
    UNKNOWN = "unknown"


class VersionStatus(Enum):
    VULNERABLE = "vulnerable"
    NOT_VULNERABLE = "not-vulnerable"
    UNKNOWN = "unknown"  # wildcard, range, git URL — could not be compared


@dataclass(frozen=True)
class Dependency:
    name: str
    version: str
    is_direct: bool       # direct deps carry more real-world risk than transitive ones
    is_dev: bool = False  # dev-only deps never ship, so they are discounted, not promoted


@dataclass(frozen=True)
class Vulnerability:
    cve_id: str
    package: str
    affected_below: str      # "fixed in" version; vulnerable if installed < this
    severity: Severity
    exploit_maturity: str    # "proof-of-concept" | "active" | "none-known"
    summary: str
    fixed_version: str


@dataclass
class Finding:
    dependency: Dependency
    vulnerability: Vulnerability
    reachability: Reachability
    version_status: VersionStatus
    risk_score: float
    risk_level: Severity
    remediation: str

    def to_dict(self) -> dict:
        return {
            "package": self.dependency.name,
            "installed_version": self.dependency.version,
            "cve": self.vulnerability.cve_id,
            "reachability": self.reachability.value,
            "version_status": self.version_status.value,
            "risk_score": round(self.risk_score, 2),
            "risk_level": self.risk_level.name,
            "remediation": self.remediation,
        }


# ==========================================================================
# Version comparison — deliberately minimal and defensive.
# Malformed version strings are common in the wild; we must never crash on one.
# ==========================================================================

def parse_version(version: str) -> tuple[int, ...]:
    """Parses a dotted version string into a comparable tuple, ignoring pre-release suffixes."""
    core = re.match(r"^v?(\d+(?:\.\d+)*)", version.strip())
    if not core:
        raise ValueError(f"Unparseable version string: '{version}'")
    return tuple(int(part) for part in core.group(1).split("."))


def is_version_less_than(installed: str, threshold: str) -> bool:
    """Returns True if `installed` < `threshold`, padding shorter tuples with zeros."""
    a, b = parse_version(installed), parse_version(threshold)
    length = max(len(a), len(b))
    a = a + (0,) * (length - len(a))
    b = b + (0,) * (length - len(b))
    return a < b


def classify_version(installed: str, threshold: str) -> VersionStatus:
    """
    Wraps the comparison so an uncomparable spec — '*', 'latest', a git URL, a
    multi-clause range — becomes an explicit UNKNOWN finding the user has to
    look at, rather than a warning on stderr and a dependency dropped from the
    report. A gate that silently skips packages is worse than a noisy one.
    """
    try:
        return (VersionStatus.VULNERABLE if is_version_less_than(installed, threshold)
                else VersionStatus.NOT_VULNERABLE)
    except ValueError:
        return VersionStatus.UNKNOWN


# ==========================================================================
# Dependency parsing (strategy pattern — one parser per manifest format)
# ==========================================================================

class DependencyParser(ABC):
    @abstractmethod
    def can_parse(self, manifest_path: Path) -> bool:
        ...

    @abstractmethod
    def parse(self, manifest_path: Path) -> list[Dependency]:
        ...


class PackageJsonParser(DependencyParser):
    def can_parse(self, manifest_path: Path) -> bool:
        return manifest_path.name == "package.json"

    def parse(self, manifest_path: Path) -> list[Dependency]:
        try:
            manifest = json.loads(manifest_path.read_text(encoding=_ENCODING))
        except json.JSONDecodeError as error:
            raise ValueError(f"Invalid JSON in {manifest_path}: {error}") from error

        dependencies = []
        for section, is_dev in (("dependencies", False), ("devDependencies", True)):
            for name, raw_version in manifest.get(section, {}).items():
                cleaned = raw_version.lstrip("^~>=< ")
                dependencies.append(
                    Dependency(name=name, version=cleaned, is_direct=True, is_dev=is_dev)
                )
        return dependencies


class PythonRequirementsParser(DependencyParser):
    _LINE_PATTERN = re.compile(r"^([A-Za-z0-9_\-\.]+)\s*==\s*([\w\.]+)")

    def can_parse(self, manifest_path: Path) -> bool:
        return manifest_path.suffix == ".txt" and "requirement" in manifest_path.name.lower()

    def parse(self, manifest_path: Path) -> list[Dependency]:
        dependencies = []
        for line in manifest_path.read_text(encoding=_ENCODING).splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            match = self._LINE_PATTERN.match(line)
            if match:
                name, version = match.groups()
                dependencies.append(Dependency(name=name, version=version, is_direct=True))
        return dependencies


def resolve_parser(manifest_path: Path, parsers: list[DependencyParser]) -> DependencyParser:
    for parser in parsers:
        if parser.can_parse(manifest_path):
            return parser
    raise ValueError(f"No parser available for manifest type: {manifest_path.name}")


# ==========================================================================
# Vulnerability database (pluggable — swap for a Snyk API / OSV.dev client)
# ==========================================================================

class VulnerabilityDatabase(ABC):
    @abstractmethod
    def lookup(self, package_name: str) -> list[Vulnerability]:
        ...


class LocalVulnerabilityDatabase(VulnerabilityDatabase):
    """
    Demo database backed by a local JSON file. In production this class would be
    replaced by an HTTP client against Snyk's vulnerability API or OSV.dev —
    the rest of the pipeline is unaware of where the data comes from.
    """

    _BUNDLED_SAMPLE: dict[str, list[dict]] = {
        "lodash": [{
            "cve_id": "CVE-2021-23337", "affected_below": "4.17.21", "severity": "HIGH",
            "exploit_maturity": "active",
            "summary": "Command injection via template function allows arbitrary code execution.",
            "fixed_version": "4.17.21",
        }],
        "flask": [{
            "cve_id": "CVE-2023-30861", "affected_below": "2.3.2", "severity": "MEDIUM",
            "exploit_maturity": "proof-of-concept",
            "summary": "Session cookie disclosure when caching is misconfigured behind a proxy.",
            "fixed_version": "2.3.2",
        }],
        "requests": [{
            "cve_id": "CVE-2023-32681", "affected_below": "2.31.0", "severity": "MEDIUM",
            "exploit_maturity": "none-known",
            "summary": "Proxy-Authorization header leaked across redirects to a different host.",
            "fixed_version": "2.31.0",
        }],
    }

    def __init__(self, database_path: Optional[Path] = None) -> None:
        self._data = self._load(database_path)

    def _load(self, database_path: Optional[Path]) -> dict[str, list[dict]]:
        if database_path is None:
            return self._BUNDLED_SAMPLE
        try:
            return json.loads(database_path.read_text(encoding=_ENCODING))
        except (OSError, json.JSONDecodeError) as error:
            print(f"warning: could not load vulnerability DB '{database_path}' "
                  f"({error}); falling back to bundled sample data", file=sys.stderr)
            return self._BUNDLED_SAMPLE

    def lookup(self, package_name: str) -> list[Vulnerability]:
        entries = self._data.get(package_name, [])
        vulnerabilities = []
        for entry in entries:
            try:
                vulnerabilities.append(Vulnerability(
                    cve_id=entry["cve_id"],
                    package=package_name,
                    affected_below=entry["affected_below"],
                    severity=Severity.from_str(entry["severity"]),
                    exploit_maturity=entry["exploit_maturity"],
                    summary=entry["summary"],
                    fixed_version=entry["fixed_version"],
                ))
            except (KeyError, ValueError) as error:
                print(f"warning: skipping malformed DB entry for '{package_name}': {error}",
                      file=sys.stderr)
        return vulnerabilities


# ==========================================================================
# Reachability analysis — is the vulnerable package actually used?
# This is the key signal that separates noise from real risk, so the two ways
# it goes wrong both have to be handled: vendored trees (node_modules, virtual
# envs) contain imports belonging to *other* packages, and a package's install
# name is frequently not the name it is imported under.
# ==========================================================================

class ReachabilityAnalyzer:
    _IMPORT_TEMPLATES = [
        r"(?:^|\n)\s*import\s+{name}\b",
        r"(?:^|\n)\s*from\s+{name}\b",
        r"""require\(\s*['"]{name}(?:/[^'"]*)?['"]\s*\)""",
        r"""from\s+['"]{name}(?:/[^'"]*)?['"]""",
        r"""import\(\s*['"]{name}(?:/[^'"]*)?['"]\s*\)""",
    ]
    _SCANNABLE_EXTENSIONS = {".py", ".pyi", ".js", ".mjs", ".cjs", ".ts", ".jsx", ".tsx"}

    # Vendored and generated trees. An import found in here belongs to whatever
    # package vendored it, not to the project under scan.
    _EXCLUDED_DIRS = {
        "node_modules", "bower_components", "vendor",
        "venv", "virtualenv", "site-packages", "__pycache__",
        "dist", "build", "out", "coverage", "target",
    }

    # Install name -> import name, for the cases where they differ. Without this
    # a real vulnerability is scored as unused and quietly demoted.
    _IMPORT_ALIASES = {
        "beautifulsoup4": ["bs4"],
        "pyyaml": ["yaml"],
        "pillow": ["PIL"],
        "python-dateutil": ["dateutil"],
        "python-dotenv": ["dotenv"],
        "scikit-learn": ["sklearn"],
        "opencv-python": ["cv2"],
        "msgpack-python": ["msgpack"],
        "protobuf": ["google.protobuf"],
        "pycryptodome": ["Crypto"],
        "setuptools": ["pkg_resources"],
        "attrs": ["attr"],
        "typing-extensions": ["typing_extensions"],
    }

    def __init__(self, source_dir: Optional[Path]) -> None:
        self._source_dir = source_dir
        self._files: Optional[list[Path]] = None
        self._cache: dict[str, Reachability] = {}

    # -- public API --------------------------------------------------------

    def prescan(self, package_names: Iterable[str]) -> None:
        """
        Resolves every package in a single pass over the source tree, so that N
        vulnerable dependencies cost one walk rather than N walks.
        """
        pending = {name: self._patterns_for(name)
                   for name in package_names if name not in self._cache}
        if not pending:
            return

        files = [] if self._source_dir is None else self._source_files()
        if not files:
            # No source directory, or nothing scannable in it: we learned
            # nothing, so record that instead of claiming the packages are unused.
            for name in pending:
                self._cache[name] = Reachability.UNKNOWN
            return

        found: set[str] = set()
        for file_path in files:
            if len(found) == len(pending):
                break
            try:
                content = file_path.read_text(encoding=_ENCODING, errors="ignore")
            except OSError:
                continue  # unreadable file: skip, don't abort the whole scan
            for name, patterns in pending.items():
                if name not in found and any(p.search(content) for p in patterns):
                    found.add(name)

        for name in pending:
            self._cache[name] = Reachability.REACHABLE if name in found else Reachability.NOT_FOUND

    def reachability_of(self, package_name: str) -> Reachability:
        if package_name not in self._cache:
            self.prescan([package_name])
        return self._cache[package_name]

    # -- internals ---------------------------------------------------------

    def _candidate_names(self, package_name: str) -> list[str]:
        candidates = {package_name}
        candidates.update(self._IMPORT_ALIASES.get(package_name.lower(), []))
        # PyPI normalises '-' and '.' to '_' at import time (foo-bar -> foo_bar).
        candidates.add(package_name.replace("-", "_").replace(".", "_"))
        # Scoped npm packages are imported by their full '@scope/name' spelling,
        # but the bare name still shows up in re-exports and type-only imports.
        if package_name.startswith("@") and "/" in package_name:
            candidates.add(package_name.split("/", 1)[1])
        return sorted(candidates)

    def _patterns_for(self, package_name: str) -> list[re.Pattern]:
        patterns = []
        for candidate in self._candidate_names(package_name):
            escaped = re.escape(candidate)
            patterns.extend(re.compile(template.format(name=escaped))
                            for template in self._IMPORT_TEMPLATES)
        return patterns

    def _source_files(self) -> list[Path]:
        if self._files is None:
            self._files = list(self._walk())
        return self._files

    def _walk(self):
        for dir_path, dir_names, file_names in os.walk(self._source_dir):
            dir_names[:] = [d for d in dir_names
                            if d not in self._EXCLUDED_DIRS and not d.startswith(".")]
            for file_name in file_names:
                path = Path(dir_path) / file_name
                if path.suffix in self._SCANNABLE_EXTENSIONS:
                    yield path


# ==========================================================================
# Risk scoring
# ==========================================================================

_MATURITY_WEIGHT = {"active": 1.5, "proof-of-concept": 1.2, "none-known": 1.0}

# UNKNOWN is weighted exactly like REACHABLE: an inconclusive scan must not be
# able to bury a finding the way a confirmed "not used" legitimately can.
_REACHABILITY_WEIGHT = {
    Reachability.REACHABLE: 1.0,
    Reachability.UNKNOWN: 1.0,
    Reachability.NOT_FOUND: 0.4,
}

_VERSION_WEIGHT = {
    VersionStatus.VULNERABLE: 1.0,
    VersionStatus.UNKNOWN: 0.8,
}


def compute_risk(
    vulnerability: Vulnerability,
    dependency: Dependency,
    reachability: Reachability,
    version_status: VersionStatus,
) -> tuple[float, Severity]:
    """
    Combines base severity with real-world context. A CRITICAL CVE in an
    unreachable transitive dependency scores lower than a MEDIUM one in
    directly-called, actively-exploited code — matching how a security
    engineer would actually triage a backlog.
    """
    base = vulnerability.severity.value

    if dependency.is_dev:
        context_factor = 0.7  # dev-only deps are never deployed
    elif dependency.is_direct:
        context_factor = 1.2
    else:
        context_factor = 1.0

    score = (
        base
        * _REACHABILITY_WEIGHT[reachability]
        * context_factor
        * _MATURITY_WEIGHT.get(vulnerability.exploit_maturity, 1.0)
        * _VERSION_WEIGHT[version_status]
    )

    if score >= 4.5:
        level = Severity.CRITICAL
    elif score >= 3.0:
        level = Severity.HIGH
    elif score >= 1.5:
        level = Severity.MEDIUM
    else:
        level = Severity.LOW
    return score, level


# ==========================================================================
# AI remediation advisor — with a deterministic fallback so the pipeline
# never depends on an external API being available.
# ==========================================================================

class RemediationAdvisor(ABC):
    @abstractmethod
    def explain(
        self,
        dependency: Dependency,
        vulnerability: Vulnerability,
        reachability: Reachability,
        version_status: VersionStatus,
    ) -> str:
        ...


class TemplateRemediationAdvisor(RemediationAdvisor):
    """Deterministic, offline fallback — always available, no external dependency."""

    _REACH_NOTE = {
        Reachability.REACHABLE:
            "This code path appears reachable in your source, so treat this as live risk.",
        Reachability.NOT_FOUND:
            "No reference to this package was found in your source; risk is likely theoretical "
            "but should still be patched before it becomes reachable.",
        Reachability.UNKNOWN:
            "Reachability could not be determined — no source directory was scanned, or it held "
            "no scannable files — so this is scored as if it were reachable.",
    }

    def explain(
        self,
        dependency: Dependency,
        vulnerability: Vulnerability,
        reachability: Reachability,
        version_status: VersionStatus,
    ) -> str:
        if version_status is VersionStatus.UNKNOWN:
            version_note = (
                f"The declared spec '{dependency.version}' could not be compared against the "
                f"fixed version {vulnerability.fixed_version}; resolve the installed version "
                f"from your lockfile and confirm manually."
            )
        else:
            version_note = (
                f"Upgrade {dependency.name} from {dependency.version} to "
                f"{vulnerability.fixed_version} or later."
            )
        return f"{vulnerability.summary} {version_note} {self._REACH_NOTE[reachability]}"


class ClaudeRemediationAdvisor(RemediationAdvisor):
    """
    Calls the Anthropic API to produce a developer-friendly explanation and fix plan.
    Falls back to TemplateRemediationAdvisor on any failure — missing API key,
    network error, rate limit, or malformed response — so a flaky AI call never
    breaks a CI/CD security gate.
    """

    def __init__(self, model: Optional[str] = None) -> None:
        self._model = model or os.environ.get("ANTHROPIC_MODEL", "claude-sonnet-5")
        self._fallback = TemplateRemediationAdvisor()
        self._client = self._build_client()

    def _build_client(self):
        api_key = os.environ.get("ANTHROPIC_API_KEY")
        if not api_key:
            print("warning: ANTHROPIC_API_KEY not set; AI remediation disabled, using templates",
                  file=sys.stderr)
            return None
        try:
            import anthropic  # imported lazily so the module is optional
            return anthropic.Anthropic(api_key=api_key)
        except ImportError:
            print("warning: 'anthropic' package not installed; using templates", file=sys.stderr)
            return None

    def explain(
        self,
        dependency: Dependency,
        vulnerability: Vulnerability,
        reachability: Reachability,
        version_status: VersionStatus,
    ) -> str:
        if self._client is None:
            return self._fallback.explain(dependency, vulnerability, reachability, version_status)

        prompt = (
            f"A dependency scan found {vulnerability.cve_id} ({vulnerability.severity.name}) in "
            f"'{dependency.name}' version {dependency.version}. Summary: {vulnerability.summary} "
            f"Fixed in version {vulnerability.fixed_version}. "
            f"Reachability in source: {reachability.value}. "
            f"Version comparison: {version_status.value}. "
            f"Dev-only dependency: {dependency.is_dev}. "
            "In 2-3 sentences, explain the real-world risk to a developer and the exact fix to apply."
        )
        try:
            response = self._client.messages.create(
                model=self._model,
                max_tokens=300,
                messages=[{"role": "user", "content": prompt}],
            )
            text_blocks = [block.text for block in response.content if block.type == "text"]
            explanation = " ".join(text_blocks).strip()
            if not explanation:
                raise ValueError("Empty response from AI model")
            return explanation
        except Exception as error:  # network, auth, rate-limit, or schema errors — never crash the scan
            print(f"warning: AI remediation call failed ({error.__class__.__name__}: {error}); "
                  f"using template fallback for {vulnerability.cve_id}", file=sys.stderr)
            return self._fallback.explain(dependency, vulnerability, reachability, version_status)


# ==========================================================================
# Orchestration
# ==========================================================================

class SnykAIExtension:
    def __init__(
        self,
        vulnerability_db: VulnerabilityDatabase,
        advisor: RemediationAdvisor,
        source_dir: Optional[Path],
    ) -> None:
        self._db = vulnerability_db
        self._advisor = advisor
        self._reachability = ReachabilityAnalyzer(source_dir)
        self._parsers: list[DependencyParser] = [PackageJsonParser(), PythonRequirementsParser()]

    def analyze(self, manifest_path: Path) -> list[Finding]:
        if not manifest_path.exists():
            raise FileNotFoundError(f"Manifest file not found: {manifest_path}")

        parser = resolve_parser(manifest_path, self._parsers)
        dependencies = parser.parse(manifest_path)

        candidates = [
            (dependency, vulnerability)
            for dependency in dependencies
            for vulnerability in self._db.lookup(dependency.name)
        ]
        # One walk of the source tree for the whole run, not one per finding.
        self._reachability.prescan({dependency.name for dependency, _ in candidates})

        findings: list[Finding] = []
        for dependency, vulnerability in candidates:
            findings.extend(self._evaluate(dependency, vulnerability))

        return sorted(findings, key=lambda f: f.risk_score, reverse=True)

    def _evaluate(self, dependency: Dependency, vulnerability: Vulnerability) -> list[Finding]:
        version_status = classify_version(dependency.version, vulnerability.affected_below)
        if version_status is VersionStatus.NOT_VULNERABLE:
            return []

        reachability = self._reachability.reachability_of(dependency.name)
        score, level = compute_risk(vulnerability, dependency, reachability, version_status)
        remediation = self._advisor.explain(dependency, vulnerability, reachability, version_status)

        return [Finding(dependency, vulnerability, reachability, version_status, score, level, remediation)]


# ==========================================================================
# CLI
# ==========================================================================

def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="AI-powered contextual vulnerability triage.",
        epilog="Run with --selftest (and no other flags) to execute the bundled test suite.",
    )
    parser.add_argument("--manifest", type=Path, required=True, help="Path to package.json or requirements.txt")
    parser.add_argument("--source", type=Path, default=None, help="Source directory for reachability analysis")
    parser.add_argument("--db", type=Path, default=None, help="Optional custom vulnerability DB (JSON)")
    parser.add_argument("--no-ai", action="store_true", help="Disable AI calls, use offline templates only")
    parser.add_argument("--fail-on", choices=["low", "medium", "high", "critical"], default="high",
                        help="Lowest risk level that exits 1 (default: high; lesser findings exit 3)")
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    fail_on = Severity.from_str(args.fail_on)

    advisor: RemediationAdvisor = (
        TemplateRemediationAdvisor() if args.no_ai else ClaudeRemediationAdvisor()
    )
    extension = SnykAIExtension(
        vulnerability_db=LocalVulnerabilityDatabase(args.db),
        advisor=advisor,
        source_dir=args.source,
    )

    try:
        findings = extension.analyze(args.manifest)
    except (FileNotFoundError, ValueError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 2

    if not findings:
        print("No known vulnerabilities detected in current dependencies.")
        return 0

    # Report text is deliberately ASCII-only: a default Windows console is
    # cp1252, and printing an arrow or em-dash there raises UnicodeEncodeError
    # and takes down the whole gate at output time.
    print(f"Found {len(findings)} vulnerability finding(s), ranked by contextual risk:\n")
    for finding in findings:
        data = finding.to_dict()
        print(f"[{data['risk_level']}] {data['package']}@{data['installed_version']} "
              f"- {data['cve']} (score: {data['risk_score']}, "
              f"reachability: {data['reachability']}, version: {data['version_status']})")
        print(f"    -> {data['remediation']}\n")

    highest = max(finding.risk_level.value for finding in findings)
    if highest >= fail_on.value:
        print(f"gate: at least one finding at or above {fail_on.name}", file=sys.stderr)
        return 1
    print(f"gate: all findings below {fail_on.name}", file=sys.stderr)
    return 3


