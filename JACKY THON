class TestReachability(unittest.TestCase):
    def analyzer_for(self, files: dict[str, str]) -> tuple[ReachabilityAnalyzer, tempfile.TemporaryDirectory]:
        tmp = tempfile.TemporaryDirectory()
        write_tree(Path(tmp.name), files)
        return ReachabilityAnalyzer(Path(tmp.name)), tmp

    def test_node_modules_is_pruned(self):
        analyzer, tmp = self.analyzer_for({
            "src/app.js": "const x = 1;\n",
            "node_modules/other-pkg/index.js": 'const _ = require("lodash");\n',
        })
        with tmp:
            self.assertIs(analyzer.reachability_of("lodash"), Reachability.NOT_FOUND)

    def test_dot_directories_are_pruned(self):
        analyzer, tmp = self.analyzer_for({
            "app.py": "print(1)\n",
            ".venv/lib/site.py": "import flask\n",
        })
        with tmp:
            self.assertIs(analyzer.reachability_of("flask"), Reachability.NOT_FOUND)

    def test_build_output_is_pruned(self):
        analyzer, tmp = self.analyzer_for({
            "src/a.ts": "export const a = 1;\n",
            "dist/bundle.js": 'require("lodash");\n',
        })
        with tmp:
            self.assertIs(analyzer.reachability_of("lodash"), Reachability.NOT_FOUND)

    def test_direct_import_is_reachable(self):
        analyzer, tmp = self.analyzer_for({"src/app.py": "import flask\n"})
        with tmp:
            self.assertIs(analyzer.reachability_of("flask"), Reachability.REACHABLE)

    def test_alias_table_resolves_differing_import_name(self):
        analyzer, tmp = self.analyzer_for({"src/scrape.py": "from bs4 import BeautifulSoup\n"})
        with tmp:
            self.assertIs(analyzer.reachability_of("beautifulsoup4"), Reachability.REACHABLE)

    def test_pypi_dash_to_underscore_normalisation(self):
        analyzer, tmp = self.analyzer_for({"src/app.py": "import my_lib\n"})
        with tmp:
            self.assertIs(analyzer.reachability_of("my-lib"), Reachability.REACHABLE)

    def test_scoped_npm_package_matches_full_and_bare_name(self):
        analyzer, tmp = self.analyzer_for({"src/a.ts": "import x from '@scope/thing';\n"})
        with tmp:
            self.assertIs(analyzer.reachability_of("@scope/thing"), Reachability.REACHABLE)

        analyzer2, tmp2 = self.analyzer_for({"src/a.ts": "import x from 'thing';\n"})
        with tmp2:
            self.assertIs(analyzer2.reachability_of("@scope/thing"), Reachability.REACHABLE)

    def test_subpath_import_matches_parent_package(self):
        analyzer, tmp = self.analyzer_for({"src/a.js": 'const m = require("lodash/merge");\n'})
        with tmp:
            self.assertIs(analyzer.reachability_of("lodash"), Reachability.REACHABLE)

    def test_dynamic_import_matches(self):
        analyzer, tmp = self.analyzer_for({"src/a.mjs": 'const m = await import("lodash");\n'})
        with tmp:
            self.assertIs(analyzer.reachability_of("lodash"), Reachability.REACHABLE)

    def test_longer_name_with_same_prefix_does_not_match(self):
        analyzer, tmp = self.analyzer_for({"src/app.py": "import lodash_extra\n"})
        with tmp:
            self.assertIs(analyzer.reachability_of("lodash"), Reachability.NOT_FOUND)

    def test_no_source_dir_is_unknown_not_reachable(self):
        self.assertIs(ReachabilityAnalyzer(None).reachability_of("lodash"), Reachability.UNKNOWN)

    def test_tree_without_scannable_files_is_unknown(self):
        analyzer, tmp = self.analyzer_for({"README.md": "# docs\n", "data.csv": "a,b\n"})
        with tmp:
            self.assertIs(analyzer.reachability_of("lodash"), Reachability.UNKNOWN)

    def test_tree_is_walked_once_per_run(self):
        analyzer, tmp = self.analyzer_for({"src/app.py": "import flask\n"})
        with tmp, mock.patch.object(
            ReachabilityAnalyzer, "_walk", autospec=True, side_effect=ReachabilityAnalyzer._walk
        ) as spy:
            analyzer.prescan(["flask", "lodash"])
            analyzer.reachability_of("requests")   # not prescanned — must reuse the file list
            analyzer.reachability_of("flask")      # cached
            self.assertEqual(spy.call_count, 1)

