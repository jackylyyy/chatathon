class TestSnykAIExtension(unittest.TestCase):
    def run_scan(self, manifest: dict, files: dict[str, str] | None = None):
        tmp = tempfile.TemporaryDirectory()
        root = Path(tmp.name)
        (root / "package.json").write_text(json.dumps(manifest), encoding="utf-8")
        write_tree(root, files or {})
        extension = SnykAIExtension(
            vulnerability_db=LocalVulnerabilityDatabase(),
            advisor=TemplateRemediationAdvisor(),
            source_dir=root,
        )
        try:
            return extension.analyze(root / "package.json")
        finally:
            tmp.cleanup()

    def test_patched_dependency_produces_no_finding(self):
        self.assertEqual(self.run_scan({"dependencies": {"lodash": "^4.17.21"}}), [])

    def test_vulnerable_and_reachable(self):
        findings = self.run_scan(
            {"dependencies": {"lodash": "^4.17.15"}},
            {"src/app.js": 'const _ = require("lodash");\n'},
        )
        self.assertEqual(len(findings), 1)
        self.assertIs(findings[0].reachability, Reachability.REACHABLE)
        self.assertIs(findings[0].version_status, VersionStatus.VULNERABLE)
        self.assertIs(findings[0].risk_level, Severity.CRITICAL)

    def test_wildcard_spec_still_reported(self):
        findings = self.run_scan(
            {"dependencies": {"lodash": "*"}},
            {"src/app.js": 'const _ = require("lodash");\n'},
        )
        self.assertEqual(len(findings), 1)
        self.assertIs(findings[0].version_status, VersionStatus.UNKNOWN)

    def test_findings_sorted_by_descending_score(self):
        findings = self.run_scan(
            {"dependencies": {"lodash": "4.17.15", "requests": "2.30.0", "flask": "2.0.0"}},
            {"src/app.js": 'const _ = require("lodash");\n'},
        )
        scores = [f.risk_score for f in findings]
        self.assertEqual(scores, sorted(scores, reverse=True))
        self.assertEqual(findings[0].dependency.name, "lodash")

    def test_missing_manifest_raises(self):
        extension = SnykAIExtension(LocalVulnerabilityDatabase(), TemplateRemediationAdvisor(), None)
        with self.assertRaises(FileNotFoundError):
            extension.analyze(Path("does-not-exist/package.json"))

    def test_to_dict_shape(self):
        findings = self.run_scan(
            {"dependencies": {"lodash": "4.17.15"}},
            {"src/app.js": 'require("lodash");\n'},
        )
        self.assertEqual(
            set(findings[0].to_dict()),
            {"package", "installed_version", "cve", "reachability",
             "version_status", "risk_score", "risk_level", "remediation"},
        )


class TestByteOrderMarkTolerance(unittest.TestCase):
    """Windows editors and PowerShell emit UTF-8 BOMs; none of this may break on one."""

    def test_bom_in_package_json_parses(self):
        with tempfile.TemporaryDirectory() as tmp:
            path = Path(tmp) / "package.json"
            path.write_text(json.dumps({"dependencies": {"lodash": "4.17.15"}}),
                            encoding="utf-8-sig")
            deps = PackageJsonParser().parse(path)
        self.assertEqual([(d.name, d.version) for d in deps], [("lodash", "4.17.15")])

    def test_bom_in_requirements_parses(self):
        with tempfile.TemporaryDirectory() as tmp:
            path = Path(tmp) / "requirements.txt"
            path.write_text("flask==2.0.1\n", encoding="utf-8-sig")
            deps = PythonRequirementsParser().parse(path)
        self.assertEqual([(d.name, d.version) for d in deps], [("flask", "2.0.1")])

    def test_bom_before_first_line_import_still_matches(self):
        with tempfile.TemporaryDirectory() as tmp:
            source = Path(tmp) / "app.py"
            source.write_text("import flask\n", encoding="utf-8-sig")
            analyzer = ReachabilityAnalyzer(Path(tmp))
            self.assertIs(analyzer.reachability_of("flask"), Reachability.REACHABLE)

    def test_bom_in_custom_database_loads(self):
        with tempfile.TemporaryDirectory() as tmp:
            db_path = Path(tmp) / "db.json"
            db_path.write_text(json.dumps({"lodash": [{
                "cve_id": "CVE-1", "affected_below": "2.0.0", "severity": "HIGH",
                "exploit_maturity": "active", "summary": "s", "fixed_version": "2.0.0",
            }]}), encoding="utf-8-sig")
            with redirect_stderr(io.StringIO()):
                found = LocalVulnerabilityDatabase(db_path).lookup("lodash")
        self.assertEqual([v.cve_id for v in found], ["CVE-1"])


