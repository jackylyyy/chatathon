class TestPackageJsonParser(unittest.TestCase):
    def parse(self, manifest: dict) -> list[Dependency]:
        with tempfile.TemporaryDirectory() as tmp:
            path = Path(tmp) / "package.json"
            path.write_text(json.dumps(manifest), encoding="utf-8")
            return PackageJsonParser().parse(path)

    def test_dev_dependencies_are_flagged_as_dev(self):
        deps = self.parse({
            "dependencies": {"lodash": "^4.17.15"},
            "devDependencies": {"jest": "~29.0.0"},
        })
        by_name = {d.name: d for d in deps}
        self.assertFalse(by_name["lodash"].is_dev)
        self.assertTrue(by_name["jest"].is_dev)
        self.assertTrue(all(d.is_direct for d in deps))

    def test_range_prefixes_are_stripped(self):
        deps = self.parse({"dependencies": {"a": "^1.2.3", "b": "~4.5", "c": ">=2.0.0"}})
        self.assertEqual({d.name: d.version for d in deps},
                         {"a": "1.2.3", "b": "4.5", "c": "2.0.0"})

    def test_invalid_json_raises_value_error(self):
        with tempfile.TemporaryDirectory() as tmp:
            path = Path(tmp) / "package.json"
            path.write_text("{not json", encoding="utf-8")
            with self.assertRaises(ValueError):
                PackageJsonParser().parse(path)


