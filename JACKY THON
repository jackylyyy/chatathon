class TestComputeRisk(unittest.TestCase):
    def score(self, dependency, reachability, version_status=VersionStatus.VULNERABLE,
              severity="HIGH", maturity="active") -> float:
        return compute_risk(vuln(severity, maturity), dependency, reachability, version_status)[0]

    def test_dev_dependency_is_discounted_below_runtime(self):
        runtime = Dependency("pkg", "1.0.0", is_direct=True, is_dev=False)
        dev = Dependency("pkg", "1.0.0", is_direct=True, is_dev=True)
        self.assertAlmostEqual(self.score(runtime, Reachability.REACHABLE), 5.4)
        self.assertAlmostEqual(self.score(dev, Reachability.REACHABLE), 3.15)

    def test_transitive_sits_between_dev_and_direct(self):
        transitive = Dependency("pkg", "1.0.0", is_direct=False, is_dev=False)
        self.assertAlmostEqual(self.score(transitive, Reachability.REACHABLE), 4.5)

    def test_unknown_reachability_is_not_discounted(self):
        dependency = Dependency("pkg", "1.0.0", is_direct=True)
        self.assertEqual(
            self.score(dependency, Reachability.UNKNOWN),
            self.score(dependency, Reachability.REACHABLE),
        )

    def test_confirmed_unreachable_is_discounted(self):
        dependency = Dependency("pkg", "1.0.0", is_direct=True)
        self.assertAlmostEqual(self.score(dependency, Reachability.NOT_FOUND), 5.4 * 0.4)

    def test_uncomparable_version_is_mildly_discounted(self):
        dependency = Dependency("pkg", "1.0.0", is_direct=True)
        self.assertAlmostEqual(
            self.score(dependency, Reachability.REACHABLE, VersionStatus.UNKNOWN), 5.4 * 0.8
        )

    def test_reachable_medium_outranks_unreachable_critical(self):
        direct = Dependency("pkg", "1.0.0", is_direct=True)
        reachable_medium = self.score(direct, Reachability.REACHABLE, severity="MEDIUM")
        unreachable_critical = self.score(
            direct, Reachability.NOT_FOUND, severity="CRITICAL", maturity="none-known"
        )
        self.assertGreater(reachable_medium, unreachable_critical)

    def test_unknown_maturity_defaults_to_neutral_weight(self):
        dependency = Dependency("pkg", "1.0.0", is_direct=True)
        self.assertAlmostEqual(
            self.score(dependency, Reachability.REACHABLE, maturity="novel"), 3 * 1.2
        )

    def level(self, dependency, reachability, version_status=VersionStatus.VULNERABLE,
              severity="HIGH", maturity="active") -> Severity:
        return compute_risk(vuln(severity, maturity), dependency, reachability, version_status)[1]

    def test_neutral_context_preserves_base_severity(self):
        """Transitive + reachable + no known exploit is the 1.0-multiplier baseline."""
        transitive = Dependency("pkg", "1.0.0", is_direct=False)
        for severity, expected in (("LOW", Severity.LOW), ("MEDIUM", Severity.MEDIUM),
                                   ("HIGH", Severity.HIGH)):
            with self.subTest(severity=severity):
                self.assertIs(
                    self.level(transitive, Reachability.REACHABLE,
                               severity=severity, maturity="none-known"),
                    expected,
                )

    def test_bare_critical_needs_context_to_stay_critical(self):
        """
        A CRITICAL with nothing else going for it scores 4.0 and lands at HIGH;
        it takes a direct dependency or a known exploit to clear the 4.5 cut.
        This demotion is the point of contextual triage, not a rounding artefact.
        """
        transitive = Dependency("pkg", "1.0.0", is_direct=False)
        direct = Dependency("pkg", "1.0.0", is_direct=True)
        self.assertIs(
            self.level(transitive, Reachability.REACHABLE, severity="CRITICAL", maturity="none-known"),
            Severity.HIGH,
        )
        self.assertIs(
            self.level(direct, Reachability.REACHABLE, severity="CRITICAL", maturity="none-known"),
            Severity.CRITICAL,
        )

    def test_unreachable_dev_dependency_bottoms_out_at_low(self):
        dev = Dependency("pkg", "1.0.0", is_direct=True, is_dev=True)
        self.assertIs(
            self.level(dev, Reachability.NOT_FOUND, severity="MEDIUM", maturity="none-known"),
            Severity.LOW,
        )


