class TestCliExitCodes(unittest.TestCase):
    def invoke(self, argv: list[str]) -> tuple[int, str]:
        out, err = io.StringIO(), io.StringIO()
        with redirect_stdout(out), redirect_stderr(err):
            code = main(argv)
        return code, out.getvalue()

    def test_clean_project_exits_zero(self):
        with tempfile.TemporaryDirectory() as tmp:
            manifest = Path(tmp) / "package.json"
            manifest.write_text(json.dumps({"dependencies": {"lodash": "4.17.21"}}), encoding="utf-8")
            code, output = self.invoke(["--manifest", str(manifest), "--source", tmp, "--no-ai"])
        self.assertEqual(code, 0)
        self.assertIn("No known vulnerabilities", output)

    def test_severe_finding_exits_one(self):
        with tempfile.TemporaryDirectory() as tmp:
            write_tree(Path(tmp), {"src/app.js": 'require("lodash");\n'})
            manifest = Path(tmp) / "package.json"
            manifest.write_text(json.dumps({"dependencies": {"lodash": "^4.17.15"}}), encoding="utf-8")
            code, output = self.invoke(["--manifest", str(manifest), "--source", tmp, "--no-ai"])
        self.assertEqual(code, 1)
        self.assertIn("CRITICAL", output)

    def test_findings_below_threshold_exit_three_not_zero(self):
        with tempfile.TemporaryDirectory() as tmp:
            write_tree(Path(tmp), {"src/app.py": "print('no imports here')\n"})
            manifest = Path(tmp) / "requirements.txt"
            manifest.write_text("requests==2.30.0\n", encoding="utf-8")
            code, output = self.invoke(
                ["--manifest", str(manifest), "--source", tmp, "--no-ai", "--fail-on", "medium"]
            )
        self.assertEqual(code, 3)
        self.assertIn("requests", output)

    def test_fail_on_low_catches_everything(self):
        with tempfile.TemporaryDirectory() as tmp:
            write_tree(Path(tmp), {"src/app.py": "print('no imports here')\n"})
            manifest = Path(tmp) / "requirements.txt"
            manifest.write_text("requests==2.30.0\n", encoding="utf-8")
            code, _ = self.invoke(
                ["--manifest", str(manifest), "--source", tmp, "--no-ai", "--fail-on", "low"]
            )
        self.assertEqual(code, 1)

    def test_report_renders_on_a_cp1252_console(self):
        """
        The default Windows console codepage cannot encode arrows or em-dashes;
        emitting one used to abort the run with UnicodeEncodeError after the
        analysis had already succeeded.
        """
        with tempfile.TemporaryDirectory() as tmp:
            write_tree(Path(tmp), {"src/app.js": 'require("lodash");\n'})
            manifest = Path(tmp) / "package.json"
            manifest.write_text(json.dumps({"dependencies": {"lodash": "4.17.15"}}),
                                encoding="utf-8")
            console = io.TextIOWrapper(io.BytesIO(), encoding="cp1252", errors="strict")
            with redirect_stdout(console), redirect_stderr(io.StringIO()):
                code = main(["--manifest", str(manifest), "--source", tmp, "--no-ai"])
                console.flush()
        self.assertEqual(code, 1)

    def test_missing_manifest_exits_two(self):
        code, _ = self.invoke(["--manifest", "nope/package.json", "--no-ai"])
        self.assertEqual(code, 2)

    def test_unsupported_manifest_exits_two(self):
        with tempfile.TemporaryDirectory() as tmp:
            manifest = Path(tmp) / "Cargo.toml"
            manifest.write_text("[package]\n", encoding="utf-8")
            code, _ = self.invoke(["--manifest", str(manifest), "--no-ai"])
        self.assertEqual(code, 2)


def run_selftest(extra_argv: list[str]) -> int:
    """Runs the bundled suite. Returns 0 on success, 1 on any failure or error."""
    loader = unittest.TestLoader()
    suite = loader.loadTestsFromModule(sys.modules[__name__])
    runner = unittest.TextTestRunner(verbosity=2 if "-v" in extra_argv else 1)
    return 0 if runner.run(suite).wasSuccessful() else 1


if __name__ == "__main__":
    # --selftest is intercepted before argparse, which would otherwise demand
    # the required --manifest flag.
    if "--selftest" in sys.argv[1:]:
        sys.exit(run_selftest([a for a in sys.argv[1:] if a != "--selftest"]))
    sys.exit(main(sys.argv[1:]))


