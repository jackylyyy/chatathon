class TestVersionParsing(unittest.TestCase):
    def test_plain_dotted_version(self):
        self.assertEqual(parse_version("4.17.15"), (4, 17, 15))

    def test_leading_v_is_accepted(self):
        self.assertEqual(parse_version("v4.17.15"), (4, 17, 15))

    def test_prerelease_suffix_is_ignored(self):
        self.assertEqual(parse_version("1.2.3-beta.1"), (1, 2, 3))

    def test_surrounding_whitespace(self):
        self.assertEqual(parse_version("  2.31.0  "), (2, 31, 0))

    def test_unparseable_raises(self):
        for spec in ("*", "latest", "", "git+https://example.com/a.git"):
            with self.subTest(spec=spec), self.assertRaises(ValueError):
                parse_version(spec)

    def test_shorter_tuple_is_zero_padded(self):
        self.assertTrue(is_version_less_than("4.17", "4.17.21"))
        self.assertFalse(is_version_less_than("4.17.21", "4.17"))
        self.assertFalse(is_version_less_than("2.0", "2.0.0"))


class TestClassifyVersion(unittest.TestCase):
    def test_below_threshold_is_vulnerable(self):
        self.assertIs(classify_version("4.17.15", "4.17.21"), VersionStatus.VULNERABLE)

    def test_at_or_above_threshold_is_clean(self):
        self.assertIs(classify_version("4.17.21", "4.17.21"), VersionStatus.NOT_VULNERABLE)
        self.assertIs(classify_version("5.0.0", "4.17.21"), VersionStatus.NOT_VULNERABLE)

    def test_uncomparable_specs_become_unknown_not_dropped(self):
        for spec in ("*", "latest", "workspace:*", "git+ssh://git@host/x.git"):
            with self.subTest(spec=spec):
                self.assertIs(classify_version(spec, "4.17.21"), VersionStatus.UNKNOWN)


