# Copy to .env and fill in. .env is gitignored.

# Required for model-generated explanations. Without it, sentinel still runs
# and falls back to the built-in ruleset explanations.
ANTHROPIC_API_KEY=

# SENTINEL_API_KEY is accepted as an alias and copied across to
# ANTHROPIC_API_KEY, which is the name the SDK actually reads.
# SENTINEL_API_KEY=

# Optional overrides.
# SENTINEL_MODEL=claude-opus-5
# SENTINEL_GUARD_MODEL=claude-opus-5
# SENTINEL_OFFLINE=false
# SENTINEL_MAX_TOKENS=8000
